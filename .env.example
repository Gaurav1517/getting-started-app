# Copy to .env for local runs (docker compose reads it automatically). Never commit .env.
# On AWS these values come from SSM Parameter Store + Secrets Manager instead (see ../ARCHITECTURE.md).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=todo
MYSQL_PASSWORD=change-me-app
MYSQL_DB=todos
BLUE_VERSION=v1.0.0
GREEN_VERSION=v2.0.0

# AWS only (set in /etc/todo/app.env on EC2): TLS to RDS using mysql2's built-in RDS CA bundle
# MYSQL_SSL=Amazon RDS
